package nebula:gateway;

world gateway {
    // Goofy workaround which I don't understand, pain
    include wasi:cli/imports@0.2.10;

    // import wasi:otel/types@0.2.0-rc.3;
    // import wasi:otel/tracing@0.2.0-rc.3;
    import wasi:otel/types@0.2.0-rc.3;
    import wasi:otel/tracing@0.2.0-rc.3;

    import nebula:demo/driver;
    import nebula:demo/pricing;
    import nebula:demo/payment;
    import nebula:demo/identity;
    import nebula:demo/matcher;

    export wasi:http/incoming-handler@0.2.10;
}