package nebula:composition;

// Step 1: Instantiate the service component
let service = new nebula:service { ... };

// Step 2: Instantiate the proxy component (first pass)
// The proxy imports orders and quotes from service, re-exports them instrumented
let proxy = new nebula:proxy {
    "nebula:service/orders": service["nebula:service/orders"],
    "nebula:service/quotes": service["nebula:service/quotes"],
    ...
};

// Step 3: Instantiate the gateway component
// The gateway imports orders and quotes from the PROXY
let gateway = new nebula:gateway {
    "nebula:service/orders": proxy["nebula:service/orders"],
    "nebula:service/quotes": proxy["nebula:service/quotes"],
    ...
};

// Step 4: Re-instantiate the proxy component to also wrap the gateway's incoming-handler
let proxy = new nebula:proxy {
    "nebula:service/orders": service["nebula:service/orders"],
    "nebula:service/quotes": service["nebula:service/quotes"],
    "wasi:http/incoming-handler": gateway["wasi:http/incoming-handler"],
    ...
};

// Step 5: Export the proxy's instrumented incoming-handler
export proxy["wasi:http/incoming-handler"];
