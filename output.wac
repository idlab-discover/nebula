    "splicer:tier1/before@0.2.0": tracing["splicer:tier1/before@0.2.0"],
    "splicer:tier1/after@0.2.0": tracing["splicer:tier1/after@0.2.0"],
    ...
};

let tracing-adapter-nebula-service-quotes = new my:tracing-adapter-nebula-service-quotes {
    "nebula:service/quotes": tracing-adapter-nebula-service-quotes["nebula:service/quotes"],
    "splicer:tier1/before@0.2.0": tracing["splicer:tier1/before@0.2.0"],
    "splicer:tier1/after@0.2.0": tracing["splicer:tier1/after@0.2.0"],
