  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch",
      "program": "${workspaceFolder}/target/debug/nebula",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug executable 'nebula'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--bin=nebula"]
      },
      "args": [
        "instrument",
        "bin/nebulift-uninstrumented.wasm",
        "--output=bin/nebulift-auto-instrument.wasm"
      ]
    },
    {
      "name": "Debug unit tests in executable 'nebula'",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--bin=nebula"]
      }
    }
  ]
}
