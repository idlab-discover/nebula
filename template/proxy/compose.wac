package nebula:composition;

// Code generation: for each original world, create glue instantiations.
let service-glue = new nebula:service { ... };
let gateway-glue = new nebula:gateway { ... };

// Code generation: create proxy instantiation with satisfied imports.
let proxy = new nebula:proxy {
    "nebula:service/orders": service-glue["nebula:service/orders"],
    "nebula:service/quotes": service-glue["nebula:service/quotes"],
    "wasi:http/incoming-handler@0.2.10": gateway-glue["wasi:http/incoming-handler@0.2.10"],
    ...
};

// Code generation: for each importing world, satisfy imports.
let gateway = new nebula:gateway {
    "nebula:service/orders": proxy["nebula:service/orders"],
    "nebula:service/quotes": proxy["nebula:service/quotes"],
    ...
};

// Code generation: export entire proxy.
